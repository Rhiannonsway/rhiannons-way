<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in | RW Move On Demand</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
  <!-- Supabase JS -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #f7f3ed; --cream-deep: #ede7dc; --sage: #7a9171; --sage-mist: #e8efe6;
      --sage-dark: #4d6b47; --stone: #6b6259; --ink: #2e2820; --white: #fff;
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Jost', sans-serif;
      --error: #c0392b;
    }
    body {
      background: #faf8f4; color: var(--ink); font-family: var(--font-body); font-weight: 300;
      min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 2rem;
    }
    .logo { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; color: var(--ink); text-decoration: none; margin-bottom: 2.5rem; display: block; text-align: center; }
    .logo span { color: var(--sage); font-style: italic; }
    .card {
      background: var(--white); border-radius: 1.4rem; padding: 2.5rem;
      border: 1px solid rgba(180,165,150,0.25); box-shadow: 0 10px 40px rgba(46,40,32,0.07);
      width: 100%; max-width: 400px;
    }
    .card-title { font-family: var(--font-display); font-size: 1.7rem; font-weight: 300; margin-bottom: 0.3rem; }
    .card-sub { font-size: 0.82rem; color: var(--stone); margin-bottom: 2rem; }
    .tabs { display: flex; gap: 0; margin-bottom: 2rem; border-radius: 2rem; overflow: hidden; background: var(--sage-mist); padding: 4px; }
    .tab-btn {
      flex: 1; padding: 0.6rem; border: none; background: none; cursor: pointer;
      font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--stone); border-radius: 2rem; transition: background 0.2s, color 0.2s;
    }
    .tab-btn.active { background: var(--white); color: var(--sage-dark); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
    label { display: block; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone); margin-bottom: 0.4rem; }
    .field { margin-bottom: 1.2rem; }
    input[type="email"], input[type="password"] {
      width: 100%; padding: 0.8rem 1rem; border: 1px solid rgba(180,165,150,0.4);
      border-radius: 0.6rem; background: var(--cream); font-family: var(--font-body); font-size: 0.9rem;
      color: var(--ink); outline: none; transition: border-color 0.2s;
    }
    input:focus { border-color: var(--sage); }
    .btn {
      width: 100%; padding: 0.9rem; background: var(--sage-dark); color: var(--white);
      border: none; border-radius: 2rem; cursor: pointer; font-family: var(--font-body);
      font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase;
      transition: background 0.2s, transform 0.2s; margin-top: 0.5rem;
    }
    .btn:hover { background: var(--sage); transform: translateY(-1px); }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .msg { font-size: 0.82rem; margin-top: 1rem; padding: 0.8rem 1rem; border-radius: 0.6rem; display: none; }
    .msg.error { background: #fdecea; color: var(--error); border: 1px solid rgba(192,57,43,0.2); display: block; }
    .msg.success { background: var(--sage-mist); color: var(--sage-dark); border: 1px solid rgba(122,145,113,0.3); display: block; }
    .back-link { margin-top: 1.5rem; text-align: center; font-size: 0.78rem; color: var(--stone); }
    .back-link a { color: var(--sage-dark); text-decoration: none; }
    .back-link a:hover { text-decoration: underline; }
    .forgot-link { font-size: 0.75rem; color: var(--stone); text-decoration: none; display: block; text-align: right; margin-top: -0.8rem; margin-bottom: 1.2rem; }
    .forgot-link:hover { color: var(--sage-dark); }
  </style>
</head>
<body>
  <a href="../" class="logo">RW <span>Move</span></a>

  <div class="card">
    <h1 class="card-title">Welcome</h1>
    <p class="card-sub" id="card-sub">Log in to your membership</p>

    <div class="tabs">
      <button class="tab-btn active" id="tab-login" onclick="switchTab('login')">Log in</button>
      <button class="tab-btn" id="tab-signup" onclick="switchTab('signup')">Join</button>
    </div>

    <!-- LOGIN FORM -->
    <form id="form-login" onsubmit="handleLogin(event)">
      <div class="field">
        <label for="login-email">Email</label>
        <input type="email" id="login-email" autocomplete="email" required placeholder="you@example.com" />
      </div>
      <div class="field">
        <label for="login-password">Password</label>
        <input type="password" id="login-password" autocomplete="current-password" required placeholder="••••••••" />
      </div>
      <a href="#" class="forgot-link" onclick="handleForgot(event)">Forgot password?</a>
      <button type="submit" class="btn" id="btn-login">Log in</button>
      <div class="msg" id="msg-login"></div>
    </form>

    <!-- SIGNUP FORM -->
    <form id="form-signup" onsubmit="handleSignup(event)" style="display:none;">
      <div class="field">
        <label for="signup-email">Email</label>
        <input type="email" id="signup-email" autocomplete="email" required placeholder="you@example.com" />
      </div>
      <div class="field">
        <label for="signup-password">Choose a password</label>
        <input type="password" id="signup-password" autocomplete="new-password" required placeholder="At least 8 characters" minlength="8" />
      </div>
      <button type="submit" class="btn" id="btn-signup">Create account &amp; subscribe</button>
      <div class="msg" id="msg-signup"></div>
      <p style="font-size:0.72rem; color:var(--stone); text-align:center; margin-top:1rem; line-height:1.6;">
        By joining you agree to our <a href="../terms/" style="color:var(--sage-dark);">Terms</a> and <a href="../privacy/" style="color:var(--sage-dark);">Privacy Policy</a>. You'll be taken to a secure checkout to set up your £4.99/month membership.
      </p>
    </form>
  </div>

  <p class="back-link"><a href="../">← Back to RW Move On Demand</a></p>

  <script>
    // ── CONFIG ───────────────────────────────────────────────────────────────
    // Replace these with your actual Supabase project values
    const SUPABASE_URL = 'https://mwsqbkggccryjudjromn.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im13c3Fia2dnY2NyeWp1ZGpyb21uIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE3ODc1MTIsImV4cCI6MjEwNzM2MzUxMn0.vZX7-SCCWUu40PUnh3sa9HOiiJEKfCgvSAUnck5Cq1g';
    // Stripe Checkout link (created in Stripe dashboard, mode=subscription)
    const STRIPE_CHECKOUT_URL = 'https://buy.stripe.com/3cI7sL5LT1D5flA7Jp6oo09';
    // ─────────────────────────────────────────────────────────────────────────

    const { createClient } = supabase;
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // Auto-switch to signup tab if URL has ?signup=true
    if (new URLSearchParams(location.search).get('signup') === 'true') {
      switchTab('signup');
    }

    // Redirect if already logged in and a member
    (async () => {
      const { data: { session } } = await sb.auth.getSession();
      if (session) {
        const { data: profile } = await sb.from('profiles').select('is_member').eq('id', session.user.id).single();
        if (profile?.is_member) { window.location.href = '../library/'; }
      }
    })();

    function switchTab(tab) {
      document.getElementById('form-login').style.display = tab === 'login' ? '' : 'none';
      document.getElementById('form-signup').style.display = tab === 'signup' ? '' : 'none';
      document.getElementById('tab-login').classList.toggle('active', tab === 'login');
      document.getElementById('tab-signup').classList.toggle('active', tab === 'signup');
      document.getElementById('card-sub').textContent = tab === 'login' ? 'Log in to your membership' : 'Join for £4.99/month';
    }

    function showMsg(id, type, text) {
      const el = document.getElementById(id);
      el.className = 'msg ' + type;
      el.textContent = text;
    }

    async function async handleLogin(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-login');
      btn.disabled = true; btn.textContent = 'Logging in…';
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;
      const { data, error } = await sb.auth.signInWithPassword({ email, password });
      if (error) {
        showMsg('msg-login', 'error', error.message || 'Login failed. Please check your email and password.');
        btn.disabled = false; btn.textContent = 'Log in'; return;
      }
      // Check membership
      const { data: profile } = await sb.from('profiles').select('is_member').eq('id', data.user.id).single();
      if (profile?.is_member) {
        window.location.href = '../library/';
      } else {
        // Logged in but no active membership — send to checkout
        const userId = data.user.id;
        showMsg('msg-login', 'success', 'Account found. Taking you to subscribe…');
        setTimeout(() => { window.location.href = STRIPE_CHECKOUconst OWNER_EMAIL = 'rhiannonsway90@gmail.com';
        if (data.user.email === OWNER_EMAIL) {
          window.location.href = '/on-demand/library/';
          return;
        }
        const { data: profile } = await sb.from('profiles').select('is_member').eq('id', userId).single();
        if (profile?.is_member) {
          window.location.href = '/on-demand/library/';
        } else {
          window.location.href = STRIPE_CHECKOUT_URL + '?prefilled_email=' + encodeURIComponent(email) + '&client_reference_id=' + encodeURIComponent(userId);
        } }, 1200);

    async handleSignup(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-signup');
      btn.disabled = true; btn.textContent = 'Creating account…';
      const email = document.getElementById('signup-email').value.trim();
      const password = document.getElementById('signup-password').value;
      const { data, error } = await sb.auth.signUp({ email, password });
      if (error) {
        showMsg('msg-signup', 'error', error.message || 'Sign-up failed. Please try again.');
        btn.disabled = false; btn.textContent = 'Create account & subscribe'; return;
      }
      showMsg('msg-signup', 'success', 'Accconst userId = data.user.id;
        ount created! Taking you to subscribe…');
      setTimeout(() => { window.location.href = STRIPE_CHECKOUT_URL + '?prefilled_email=' + encodeUconst OWNER_EMAIL = 'rhiannonsway90@gmail.com';
        if (data.user.email === OWNER_EMAIL) {
          window.location.href = '/on-demand/library/';
          return;
        }
        const { data: profile } = await sb.from('profiles').select('is_member').eq('id', userId).single();
        if (profile?.is_member) {
          window.location.href = '/on-demand/library/';
        } else {
          window.location.href = STRIPE_CHECKOUT_URL + '?prefilled_email=' + encodeURIComponent(email) + '&client_reference_id=' + encodeURIComponent(userId);
        } }, 1200);   const email = document.getElementById('login-email').value.trim();
      if (!email) { showMsg('msg-login', 'error', 'Enter your email above first.'); return; }
      const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo: window.location.origin + '/on-demand/login/reset/' });
      if (error) { showMsg('msg-login', 'error', error.message); }
      else { showMsg('msg-login', 'success', 'Check your inbox — a reset link is on its way.'); }
    }
  </script>
</body>
</html>
